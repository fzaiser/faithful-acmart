// ACM's named colors (acmart defines these via \definecolor). The two below are
// each referenced from more than one module, so they live here as the single source:
//   ACM Orange — the \anon substitute text and the acmcp "Review" article banner,
//   ACM Purple — the on-screen citation/link color and the acmcp "Invited" banner.
#let acm-orange = cmyk(0%, 42%, 100%, 1%)
#let acm-purple = cmyk(55%, 100%, 0%, 15%)
