# Python environments for diff tooling
.venv/
tools/venv/

# Python bytecode cache
__pycache__/
*.pyc

# Generated LaTeX reference build (regenerate from acmart/ via the harness)

# Sample .tex extracted from samples.dtx by samples.ins / the Makefile (the
# harness re-extracts into tests/out/latex; these are pure build artifacts).
acmart/samples/*.tex

# Visual-diff outputs
tests/out/

# Working notes kept around while something is in progress: review findings,
# audits, drafts. Never committed, and excluded from the package in typst.toml.
scratch/

# Compiled test PDFs and scratch
tests/*.pdf
tests/_*
template/*.pdf

# LaTeX aux files
*.aux
*.log
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

.DS_Store
*.out
*.bcf
*.run.xml
