% Fixtures for the BibLaTeX drivers that carry no publication venue — misc (which
% every driverless entry type aliases to), online, manual, dataset — plus the
% `version` field format they share with article/report, and entries with no date
% at all. Every expected string in the two twins was read off real LaTeX.
%
% One entry deliberately has no name list, because biber's nty sort puts its
% title in the name slot; its title sorts ahead of every surname here, which is
% where our sort key (empty name, then title) puts it too.

@misc{MiscNoName,
  title        = {An authorless misc with an organization},
  organization = {Authorless Org},
  address      = {Vienna},
  year         = 2023,
  month        = feb,
}

